{
  "type": "module",
  "name": "@openvouch/lending-website-backend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply openvouch-originate-db-staging --local --config wrangler.staging.jsonc",
    "db:migrate:staging": "wrangler d1 migrations apply openvouch-originate-db-staging --remote --config wrangler.staging.jsonc",
    "db:migrate:production": "wrangler d1 migrations apply openvouch-originate-db-production --remote --config wrangler.production.jsonc",
    "deploy:staging": "wrangler deploy --config wrangler.staging.jsonc",
    "deploy:production": "wrangler deploy --config wrangler.production.jsonc",
    "dev": "wrangler dev --config wrangler.staging.jsonc",
    "lint": "echo \"No linter configured yet\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@openvouch/idl": "*",
    "@anchor-lang/core": "^1.0.0",
    "@noble/ed25519": "^2.1.0",
    "bs58": "^6.0.0",
    "drizzle-orm": "^0.43.0",
    "hono": "^4.0.0",
    "jose": "^6.0.0",
    "@fastify/cors": "^10.0.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "happy-dom": "20.9.0",
    "nodemailer": "^8.0.5",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "@hono/node-server": "^1.0.0",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.0",
    "@types/nodemailer": "^6.4.14",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.83.0"
  },
  "engines": {
    "node": ">=22"
  }
}
