{
  "address": "11111111111111111111111111111112",
  "metadata": {
    "name": "generic_record",
    "version": "0.1.0",
    "spec": "0.1.0",
    "description": "Generic two-signer record program"
  },
  "instructions": [
    {
      "name": "createRecord",
      "discriminator": [0, 0, 0, 0, 0, 0, 0, 0],
      "accounts": [
        { "name": "signer1", "writable": true, "signer": true },
        { "name": "signer2", "signer": true },
        { "name": "record", "writable": true },
        { "name": "systemProgram", "address": "11111111111111111111111111111111" }
      ],
      "args": [
        { "name": "txLink", "type": { "option": "string" } },
        { "name": "externalUrl", "type": { "option": "string" } },
        { "name": "text", "type": "string" }
      ]
    }
  ],
  "accounts": [
    {
      "name": "RecordEntry",
      "discriminator": [0, 0, 0, 0, 0, 0, 0, 0]
    }
  ],
  "types": [
    {
      "name": "RecordEntry",
      "type": {
        "kind": "struct",
        "fields": [
          { "name": "signer1", "type": "pubkey" },
          { "name": "signer2", "type": "pubkey" },
          { "name": "txLink",       "type": { "option": "string" } },
          { "name": "externalUrl",  "type": { "option": "string" } },
          { "name": "timestamp",    "type": "i64" },
          { "name": "text",         "type": "string" }
        ]
      }
    }
  ],
  "errors": [
    { "code": 6000, "name": "TextTooLong",      "msg": "text must be 256 characters or fewer" },
    { "code": 6001, "name": "TxLinkTooLong",    "msg": "tx_link must be 100 characters or fewer" },
    { "code": 6002, "name": "ExternalUrlTooLong", "msg": "external_url must be 200 characters or fewer" }
  ]
}
