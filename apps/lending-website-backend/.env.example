# lending-website-backend — local development environment
# Copy to .env and fill in values before running `npm run dev`

# Port for the local Fastify server (default: 3000)
PORT=3000

# ── Companies House API ───────────────────────────────────────────────────────
# Register free at https://developer.company-information.service.gov.uk
CH_API_KEY=your_companies_house_api_key

# ── Solana ────────────────────────────────────────────────────────────────────
# Devnet RPC — no key needed
SOLANA_RPC=https://api.devnet.solana.com
# Path to your Solana keypair JSON (used to sign transactions)
SOLANA_KEYPAIR=~/.config/solana/id.json

# ── Email (OTP) ───────────────────────────────────────────────────────────────
# Leave blank to use dev mode (OTP logged to console instead of sent)
SENDGRID_KEY=
EMAIL_FROM=noreply@openvouch.io
