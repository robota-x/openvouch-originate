# lending-website-backend — local development environment
# Copy to .env and fill in values before running `npm run dev`

# ── Local Fastify server ──────────────────────────────────────────────────────
# Used by `npm run dev` (tsx, plain Node.js — no D1, no Workers runtime)

PORT=3000

# JWT signing secret (min 32 random characters)
# For Cloudflare Workers: wrangler secret put JWT_SECRET --config wrangler.staging.jsonc
JWT_SECRET=

# ── Local Workers runtime (wrangler dev) ─────────────────────────────────────
# `npx wrangler dev` runs the Worker in Miniflare with a local D1 simulation.
# No extra env vars needed — D1 is available automatically as env.DB.
# Run `npm run db:migrate:local` first to apply any pending migrations to the
# local SQLite file.

# ── Database migrations ───────────────────────────────────────────────────────
# db:migrate:local      → applies to local Miniflare SQLite (no credentials needed)
#
# See root .env.example for how to provide Cloudflare credentials locally.
