{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "NodeNext",

    "strict": true,
    "skipLibCheck": true,

    "types": ["@cloudflare/workers-types", "node"],

    "lib": ["ES2022"],

    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["src"]
}
