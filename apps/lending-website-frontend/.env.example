# lending-website-frontend — local development environment
# Copy to .env and fill in values before running `npm run dev`

# Local deterministic ports:
# - lending frontend:                 http://localhost:5173
# - lending-website-backend:          http://localhost:8787
# - attestation-uk-company-service:   http://localhost:8788
# - attestation-identity-service:     http://localhost:8789
#
# Solana RPC endpoint
# For localchain (make dev-localchain): set in .env.localchain automatically via --mode localchain
# For staging/production builds: set to the appropriate devnet/mainnet RPC URL
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com

# Base URL of the lending-website-backend API
# Staging / production: set to the deployed worker URL before building
VITE_API_BASE_URL=http://localhost:8787

# Base URL of the attestation-identity-service API
# Local dev: point at identity worker (default port 8789)
# Staging / production: set to the deployed identity worker URL before building
VITE_IDENTITY_API_BASE_URL=http://localhost:8789

# Base URL of the attestation-uk-company-service API
# Local dev: point at attestation worker (default port 8788)
# Staging / production: set to deployed attestation worker URL before building
VITE_ATTESTATION_API_BASE_URL=http://localhost:8788
