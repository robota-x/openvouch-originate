{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "openvouch-attestation-uk-company-service-production",
  "main": "src/worker.ts",
  "compatibility_date": "2026-04-13",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openvouch-attestation-uk-company-db-production",
      "database_id": "f4e80cc7-b9d5-4791-9d07-7e226ae42906"
    }
  ]
  // COMPANIES_HOUSE_UK_API_KEY, SENDGRID_KEY, EMAIL_FROM must be set as wrangler secrets:
  //   wrangler secret put COMPANIES_HOUSE_UK_API_KEY --config wrangler.production.jsonc
}
