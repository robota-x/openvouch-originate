{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "openvouch-attestation-service-staging",
  "main": "src/worker.ts",
  "compatibility_date": "2026-04-13",
  "compatibility_flags": ["nodejs_compat"]
  // CH_API_KEY, SENDGRID_KEY, EMAIL_FROM must be set as wrangler secrets:
  //   wrangler secret put CH_API_KEY --config wrangler.staging.jsonc
}
