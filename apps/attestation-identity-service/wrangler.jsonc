{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openvouch-attestation-identity-service",
  "main": "src/worker.ts",
  "compatibility_date": "2024-04-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "SHUFTI_BASE_URL": "https://api.shuftipro.com"
  }
}
