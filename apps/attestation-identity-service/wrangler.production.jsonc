{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "openvouch-attestation-identity-service-production",
  "main": "src/worker.ts",
  "compatibility_date": "2024-04-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openvouch-attestation-identity-db-production",
      "database_id": "f11c3a74-572f-4a3c-9766-744f98e7ecbd"
    }
  ],
  "vars": {
    "IDENTITY_PROVIDER_MODE": "mock",
    "VERIFY_PORTAL_BASE_URL": "https://openvouch-originate.robota.dev",
    "SHUFTI_BASE_URL": "https://api.shuftipro.com",
    "CALLBACK_URL": "https://openvouch-attestation-identity-service-production.robota.dev/verify/webhook"
  }
}
