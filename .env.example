# Root-level environment configuration
# Each app manages its own .env — see apps/*/.env.example

# ── GitHub Actions secrets ────────────────────────────────────────────────────
# These are NOT local .env values. Set them in:
#   GitHub → Settings → Secrets and variables → Actions → Repository secrets
#
# CLOUDFLARE_ACCOUNT_ID   Your Cloudflare account ID (found in the CF dashboard)
# CLOUDFLARE_API_TOKEN    API token with "Workers Scripts: Edit" permission
